# ==================== 数据文件 ====================
# 原始数据和中间结果体积大、可由脚本或数据库重建，不进入 Git。
data/raw/*
!data/raw/.gitkeep
!data/raw/*.py
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# 正式聚合结果可提交；逐样本队列明细超过 GitHub 单文件限制，运行 SQL 后本地生成。
reports/data_exports/cohort_detail_48h.csv

# ==================== 正式交付的本地 QA 产物 ====================
# 正式 Excel 本身保留；渲染预览和内部检查快照可重新生成。
outputs/formal_delivery/qa_previews/
outputs/formal_delivery/*.inspect.ndjson

